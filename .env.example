# ==============================================================================
# Electric Vehicle Showroom ERP - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# Production Note: All secrets, keys, and credentials must be explicitly configured
# with cryptographically random tokens and secure passwords in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production | test
ENVIRONMENT=development
# Debug mode: true for verbose error logging, false for production
DEBUG=false
PROJECT_NAME="EV Showroom ERP"
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ev_showroom_erp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Async Database Connection URL
# Standard format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ev_showroom_erp

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# CACHING & BROKER CONFIGURATION (REDIS)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Connection URL format: redis://[:password@]host:port/db
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a cryptographically secure random key in production!
# e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (no spaces between entries)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
RATE_LIMIT_WINDOW=300

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
# Base URL consumed by frontend client requests
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# CONTAINER HOST PORT EXPOSURES (DOCKER COMPOSE)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
