# Test Environment
ENVIRONMENT=test
PROJECT_NAME="EV Showroom ERP - Test"
DEBUG=True

# Database - Use a separate DB for tests!
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ev_erp_test

# Security
JWT_SECRET_KEY=super-secret-test-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# Redis (optional for tests)
# REDIS_URL=redis://localhost:6379/1

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=False
