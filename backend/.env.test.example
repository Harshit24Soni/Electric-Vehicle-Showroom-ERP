# ==============================================================================
# Backend Test Environment Configuration Template
# Strictly isolated test configuration; credentials must be explicitly provided.
# ==============================================================================

# Application Configuration
ENVIRONMENT=test
DEBUG=true
PROJECT_NAME="EV Showroom ERP - Test"
API_V1_STR=/api/v1

# Test Database Configuration (strictly required; e.g. postgresql+asyncpg://user:pass@host:5432/ev_erp_test)
DATABASE_URL=<INSERT_VALUE_HERE>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Test Security (strictly required; secret key for signing test JWTs)
JWT_SECRET_KEY=<INSERT_VALUE_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# Test Redis Configuration (strictly required; e.g. redis://host:6379/1)
REDIS_URL=<INSERT_VALUE_HERE>
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT=5
RATE_LIMIT_WINDOW=300
