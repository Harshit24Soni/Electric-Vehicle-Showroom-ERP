# ==============================================================================
# Backend Environment Configuration Template
# All infrastructure credentials must be explicitly configured.
# ==============================================================================

# Application Configuration
ENVIRONMENT=<INSERT_VALUE_HERE>
DEBUG=false
PROJECT_NAME="EV Showroom ERP"
API_V1_STR=/api/v1

# Database Configuration (strictly required; e.g. postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=<INSERT_VALUE_HERE>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Authentication (strictly required; generate a cryptographically strong secret)
JWT_SECRET_KEY=<INSERT_VALUE_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# Redis Configuration (strictly required; e.g. redis://host:6379/0 or redis://:pass@host:6379/0)
REDIS_URL=<INSERT_VALUE_HERE>
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=

# CORS Origins (comma-separated list of allowed web client origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
RATE_LIMIT_WINDOW=300
