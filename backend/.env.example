# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/showroom_db

# JWT / AUTH
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RATE LIMITING
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
RATE_LIMIT_WINDOW=300

# APP
DEBUG=false
ENVIRONMENT=production
