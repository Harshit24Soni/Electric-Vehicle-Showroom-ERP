# ==============================================================================
# Electric Vehicle Showroom ERP - Consolidated Git Ignore Rules
# Single source of truth for Root, Backend, and Frontend.
# ==============================================================================

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.xml

# Node / Frontend
node_modules/
dist/
dist-ssr/
.vite/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Environment & Secrets (Only .env.example templates should be tracked)
.env
.env.*
!.env.example

# IDEs & OS files
.vscode/
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Playwright & Test Results
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/

# Temporary dumps and diagnostic logs
*.log
*.tmp
*_files_ansi.txt
*_files_clean.txt